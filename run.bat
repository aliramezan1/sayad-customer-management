@echo off
chcp 65001 > nul
title سامانه جامع صیاد پرو (نسخه ۲.۰)
cd /d "C:\Users\HP\Desktop\نام و نام خانوادگی مشتریان"

echo ====================================================================
echo   سامانه جامع مدیریت مشتریان و استعلام صیادی پاسارگاد (صیاد پرو)
echo   قابلیت دسترسی محلی و شبکه (Remote / Mobile / LAN)
echo ====================================================================
echo.
echo در حال آزادسازی پورت ۸۰۰۰ و راه‌اندازی سرور هوشمند...

for /f "tokens=5" %%a in ('netstat -aon ^| findstr ":8000" ^| findstr "LISTENING"') do taskkill /f /pid %%a > nul 2>&1

echo.
echo ====================================================================
echo   پیوندهای دسترسی به برنامه:
echo   💻 روی همین کامپیوتر:    http://127.0.0.1:8000
echo   📱 روی موبایل یا تبلت:   http://192.168.70.143:8000
echo ====================================================================
echo.
timeout /t 1 > nul
start http://127.0.0.1:8000

echo سرور فعال است. این پنجره را تا پایان کار نبندید.
echo.
"C:\Users\HP\AppData\Local\Programs\Python\Python312\python.exe" -m uvicorn app.main:app --host 0.0.0.0 --port 8000
pause
